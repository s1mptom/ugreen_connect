{
  "config": {
    "step": {
      "user": {
        "title": "UGREEN Connect",
        "description": "Sign in with the same account you use in the UgreenConnect app. Pick the region your account was registered in — accounts are not shared between regions.",
        "data": {
          "email": "Email",
          "password": "Password",
          "region": "Region",
          "debug_dump": "Write a raw cloud snapshot to the config folder"
        },
        "data_description": {
          "debug_dump": "Saves ugreen_connect_debug.json once per restart. Useful while the integration is still being built out; safe to turn off later."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate UGREEN Connect",
        "description": "The password for {email} was rejected. Enter it again.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the UGREEN cloud.",
      "invalid_auth": "The account or password was rejected."
    },
    "abort": {
      "already_configured": "This account is already set up.",
      "reauth_successful": "Re-authentication was successful."
    }
  },
  "selector": {
    "region": {
      "options": {
        "europe": "Europe",
        "america": "Americas",
        "asia": "Asia / Rest of world",
        "china": "China"
      }
    }
  },
  "entity": {
    "sensor": {
      "status": {
        "name": "Cloud status",
        "state": {
          "online": "Online",
          "offline": "Offline"
        }
      }
    },
    "select": {
      "charging_mode": {
        "name": "Charging mode",
        "state": {
          "adaptive_power": "Adaptive power",
          "thermal_safe": "Thermal safe",
          "dc_turbo": "DC turbo",
          "priority": "Priority",
          "custom": "Custom"
        }
      },
      "clock_style": {
        "name": "Clock style",
        "state": {
          "style_1": "Style 1",
          "style_2": "Style 2"
        }
      },
      "time_format": {
        "name": "Time format",
        "state": {
          "12h": "12-hour",
          "24h": "24-hour"
        }
      },
      "screen_off_time": {
        "name": "Screen off time",
        "state": {
          "1_min": "1 minute",
          "5_min": "5 minutes",
          "10_min": "10 minutes",
          "30_min": "30 minutes",
          "always_on": "Always on"
        }
      },
      "wallpaper": {
        "name": "Wallpaper",
        "state": {
          "none": "None"
        }
      }
    }
  }
}
